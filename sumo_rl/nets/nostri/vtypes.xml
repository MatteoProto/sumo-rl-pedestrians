<?xml version="1.0" encoding="UTF-8"?>
<!--
    vtypes.xml — tipi di veicolo e pedone riutilizzabili su qualsiasi rete.
    Non contiene riferimenti a edge/route: può essere incluso così com'è
    in qualunque file di rotte con:

        <routes xmlns:xsi="..." xsi:noNamespaceSchemaLocation="...">
            <include href="vtypes.xml"/>
            ...
        </routes>

    oppure passato a sumo/sumo-gui come file additivo separato
    (-a vtypes.xml) insieme al file delle route generato per la rete.
-->
<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">

    <!-- ============================ VEICOLI ============================ -->

    <vType id="auto_normale"
           vClass="passenger"
           accel="2.6" decel="4.5" emergencyDecel="9.0"
           sigma="0.5" length="4.5" minGap="2.5"
           maxSpeed="50.0"
           speedFactor="normc(1.0,0.1,0.8,1.2)"
           lcStrategic="1.0" lcCooperative="0.8" lcSpeedGain="1.2" lcKeepRight="1.0"
           guiShape="passenger" color="0.2,0.4,0.8"/>

    <vType id="auto_aggressivo"
           vClass="passenger"
           accel="3.5" decel="5.5" emergencyDecel="9.0"
           sigma="0.2" length="4.5" minGap="1.5"
           maxSpeed="55.0"
           speedFactor="normc(1.1,0.08,0.95,1.3)"
           lcStrategic="2.0" lcCooperative="0.2" lcSpeedGain="3.0" lcKeepRight="0.0"
           lcAssertive="2.5" lcImpatience="0.7"
           guiShape="passenger" color="0.9,0.1,0.1"/>

    <vType id="auto_prudente"
           vClass="passenger"
           accel="1.5" decel="3.0" emergencyDecel="7.0"
           sigma="0.8" length="4.5" minGap="3.5"
           maxSpeed="45.0"
           speedFactor="normc(0.8,0.06,0.65,0.95)"
           lcStrategic="0.5" lcCooperative="1.0" lcSpeedGain="0.3" lcKeepRight="4.0"
           guiShape="passenger" color="0.1,0.7,0.2"/>

    <vType id="camion"
           vClass="truck"
           accel="0.8" decel="2.5" emergencyDecel="6.0"
           sigma="0.3" length="12.0" width="2.5" minGap="3.0"
           maxSpeed="36.0"
           speedFactor="normc(0.9,0.05,0.8,1.0)"
           lcStrategic="0.2" lcCooperative="0.7" lcSpeedGain="0.1" lcKeepRight="6.0"
           guiShape="truck" color="0.6,0.4,0.1"/>

    <vType id="moto"
           vClass="motorcycle"
           accel="4.0" decel="6.0" emergencyDecel="10.0"
           sigma="0.4" length="2.0" width="0.8" minGap="1.0"
           maxSpeed="60.0"
           speedFactor="normc(1.1,0.15,0.8,1.4)"
           lcStrategic="1.5" lcCooperative="0.5" lcSpeedGain="2.5" lcKeepRight="0.3"
           guiShape="motorcycle" color="0.8,0.5,0.0"/>

    <!--
        NOTA: i maxSpeed sopra sono limiti FISICI del veicolo (m/s), non legati
        a una rete specifica. La velocità effettiva su ogni arco è comunque il
        minimo tra questo limite e (limite dell'arco × speedFactor), quindi i
        vType restano validi e coerenti su reti con limiti di velocità diversi.
    -->

    <!-- ============================ PEDONI ============================= -->

    <vType id="pedone_normale"
           vClass="pedestrian"
           maxSpeed="1.39"
           speedFactor="normc(1.0,0.2,0.6,1.5)"
           length="0.25" width="0.5"
           guiShape="pedestrian" color="1.0,1.0,0.0"/>

    <vType id="pedone_veloce"
           vClass="pedestrian"
           maxSpeed="2.2"
           speedFactor="normc(1.1,0.1,0.9,1.3)"
           length="0.25" width="0.5"
           guiShape="pedestrian" color="1.0,0.5,0.0"/>

    <vType id="pedone_lento"
           vClass="pedestrian"
           maxSpeed="0.7"
           speedFactor="normc(0.9,0.15,0.6,1.1)"
           length="0.25" width="0.5"
           guiShape="pedestrian" color="0.7,0.7,1.0"/>

</additional>
