<?xml version="1.0" encoding="UTF-8"?>
<edges xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/edges_file.xsd">

    <!-- Incoming outer segments: two lanes -->
    <edge id="N_outer_in" from="N0" to="N1" numLanes="2" speed="13.89" priority="2"/>
    <edge id="S_outer_in" from="S0" to="S1" numLanes="2" speed="13.89" priority="2"/>
    <edge id="E_outer_in" from="E0" to="E1" numLanes="2" speed="13.89" priority="2"/>
    <edge id="W_outer_in" from="W0" to="W1" numLanes="2" speed="13.89" priority="2"/>

    <!-- Incoming approach segments: three lanes near the junction -->
    <edge id="N_in" from="N1" to="J0" numLanes="3" speed="13.89" priority="3"/>
    <edge id="S_in" from="S1" to="J0" numLanes="3" speed="13.89" priority="3"/>
    <edge id="E_in" from="E1" to="J0" numLanes="3" speed="13.89" priority="3"/>
    <edge id="W_in" from="W1" to="J0" numLanes="3" speed="13.89" priority="3"/>

    <!-- Outgoing roads remain two lanes -->
    <edge id="N_out" from="J0" to="N1" numLanes="2" speed="13.89" priority="2"/>
    <edge id="S_out" from="J0" to="S1" numLanes="2" speed="13.89" priority="2"/>
    <edge id="E_out" from="J0" to="E1" numLanes="2" speed="13.89" priority="2"/>
    <edge id="W_out" from="J0" to="W1" numLanes="2" speed="13.89" priority="2"/>

    <edge id="N_outer_out" from="N1" to="N0" numLanes="2" speed="13.89" priority="2"/>
    <edge id="S_outer_out" from="S1" to="S0" numLanes="2" speed="13.89" priority="2"/>
    <edge id="E_outer_out" from="E1" to="E0" numLanes="2" speed="13.89" priority="2"/>
    <edge id="W_outer_out" from="W1" to="W0" numLanes="2" speed="13.89" priority="2"/>
</edges>
