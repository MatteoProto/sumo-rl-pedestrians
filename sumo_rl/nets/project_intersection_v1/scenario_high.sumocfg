<?xml version='1.0' encoding='UTF-8'?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="project_intersection.net.xml" />
        <route-files value="scenario_high.rou.xml" />
    </input>
    <time>
        <begin value="0" />
        <end value="3600" />
        <step-length value="1" />
    </time>
    <processing>
        <time-to-teleport value="-1" />
        <collision.action value="warn" />
    </processing>
    <report>
        <verbose value="true" />
        <no-step-log value="true" />
        <duration-log.statistics value="true" />
    </report>
    <output>
        <tripinfo-output value="outputs/high_tripinfo.xml" />
        <summary-output value="outputs/high_summary.xml" />
        <statistic-output value="outputs/high_statistics.xml" />
    </output>
</configuration>